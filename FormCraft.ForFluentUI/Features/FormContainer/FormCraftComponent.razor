@namespace FormCraft.ForFluentUI
@typeparam TModel where TModel : new()
@inject IFieldRendererService FieldRendererService

@if (BeforeForm != null)
{
    @BeforeForm
}

@* `novalidate` is rendered here, as a real attribute on the form EditForm emits (#206).

   It must not be bolted on afterwards by script, the way this library used to do it: that marked
   the FIRST form in the document rather than this component's, never ran during prerender because
   OnAfterRenderAsync does not execute on the server pass, failed silently through `?.`, and was
   `eval`, which a strict CSP blocks outright.

   FormCraft validates server-side and documents that the browser produces no native validation
   bubbles. That guarantee is only as good as this attribute. *@
<EditForm EditContext="@_editContext" OnSubmit="@HandleSubmit" novalidate="novalidate">
@*  ValidateCollections is ON as of #278 — and flipping it is the point, not an oversight.

    #279 introduced this flag set to `false` with the instruction "turn it on when this container
    actually renders collection fields - not before". That condition is now met: the container
    renders collection fields below, through the same IFieldRendererService registry as every other
    field (#203).

    The flag existed because a collection error attaches to the collection's own field identifier,
    and HandleSubmit gates OnValidSubmit on the validation result — so with no collection UI on
    screen, validating collections would have stopped the submit button working with no message the
    user could act on. Now that the rows are rendered, that error has somewhere to appear and a
    field the user can correct, which is exactly the state the flag was waiting for.

    ⛔ Do not set this back to `false` while collection fields render: it would accept submissions
    that violate collection validators, silently. *@
    <DynamicFormValidator TModel="TModel"
                          Configuration="@Configuration"
                          ValidateCollections="true"
                          @ref="_validator" />

    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
        @if (HasFieldGroups)
        {
            @foreach (var group in GroupedConfiguration!.FieldGroups.OrderBy(g => g.Order))
            {
                @if (group.ShowCard)
                {
                    <FluentCard Class="@group.CssClass"
                                Shadow="@ShadowFor(group.CardElevation)"
                                data-testid="formcraft-field-group-card">
                        @RenderGroupHeader(group)
                        @RenderFieldGroup(group)
                    </FluentCard>
                }
                else
                {
                    <div class="@group.CssClass">
                        @RenderGroupHeader(group)
                        @RenderFieldGroup(group)
                    </div>
                }
            }

            @* Fields that belong to no group still render, after the groups. Dropping them is the
               failure mode this arm exists to avoid: adding one group would silently hide every
               field left out of it. *@
            @RenderUngroupedFields()
        }
        else
        {
            @foreach (var field in Configuration.Fields.OrderBy(f => f.Order))
            {
                if (ShouldShowField(field))
                {
                    <div>
                        @RenderFieldWithMessages(field)
                    </div>
                }
            }
        }

        @* Collection (one-to-many) fields. Their item fields go through the same
           IFieldRendererService registry as the ordinary fields above (#203). *@
        @if (CollectionConfiguration != null)
        {
            @foreach (var collectionField in CollectionConfiguration.CollectionFields.OrderBy(f => f.Order))
            {
                if (collectionField.IsVisible)
                {
                    @(FluentUICollectionFieldRenderer.Render(Model, collectionField,
                        EventCallback.Factory.Create(this, HandleCollectionChanged)))
                }
            }
        }

        @* Security enforcement feedback (rate limiting, CSRF, misconfiguration).
           `data-testid` matches the MudBlazor container's hook so the two suites assert the
           same selector - the banner is part of the behavioural contract, not decoration. *@
        @if (!string.IsNullOrEmpty(_securityError))
        {
            @* v5 renamed this enum: MessageBarIntent, not v4's MessageIntent (#260's lesson). *@
            <FluentMessageBar Intent="MessageBarIntent.Error"
                              AllowDismiss="false"
                              data-testid="formcraft-security-error">
                @_securityError
            </FluentMessageBar>
        }

        @if (ShowSubmitButton)
        {
            <div>
                <FluentButton Type="ButtonType.Submit"
                              Appearance="ButtonAppearance.Primary"
                              Disabled="@IsSubmitting"
                              Class="@SubmitButtonClass">
                    @(IsSubmitting ? SubmittingText : SubmitButtonText)
                </FluentButton>
            </div>
        }
    </FluentStack>
</EditForm>

@if (AfterForm != null)
{
    @AfterForm
}

@code {
    /// <summary>
    /// One field plus the two things that must always travel with it - its help text and its
    /// validation messages.
    /// </summary>
    /// <remarks>
    /// Extracted because three call sites render a field (flat, inside a group's grid, and
    /// ungrouped-alongside-groups) and the MudBlazor container's equivalent trio drifted: its
    /// grouped and ungrouped arms render <c>FieldValidationMessage</c> and its grouped arm renders
    /// no help text at all. One fragment means a field cannot present differently just because of
    /// where the form put it.
    /// </remarks>
    private RenderFragment RenderFieldWithMessages(IFieldConfiguration<TModel, object> field)
    {
        return builder =>
        {
            builder.AddContent(0, RenderField(field));
            builder.OpenComponent<FieldHelpText>(1);
            builder.AddAttribute(2, "Text", field.HelpText);
            builder.AddAttribute(3, "Id", FieldHelpText.IdFor(field.FieldName));
            builder.CloseComponent();
            builder.OpenComponent<FieldValidationMessage>(4);
            builder.AddAttribute(5, "FieldName", field.FieldName);
            builder.CloseComponent();
        };
    }

    /// <summary>The group's name and optional right-hand content, when it has a name.</summary>
    private RenderFragment RenderGroupHeader(FieldGroup<TModel> group)
    {
        return builder =>
        {
            if (string.IsNullOrEmpty(group.Name))
            {
                return;
            }

            builder.OpenComponent<FluentStack>(0);
            builder.AddAttribute(1, "Orientation", Orientation.Horizontal);
            builder.AddAttribute(2, "HorizontalAlignment", HorizontalAlignment.SpaceBetween);
            builder.AddAttribute(3, "VerticalAlignment", VerticalAlignment.Center);
            builder.AddAttribute(4, "ChildContent", (RenderFragment)(header =>
            {
                header.OpenComponent<FluentLabel>(0);
                header.AddAttribute(1, "Weight", LabelWeight.Semibold);
                header.AddAttribute(2, "data-testid", "formcraft-field-group-name");
                header.AddAttribute(3, "ChildContent", (RenderFragment)(name => name.AddContent(0, group.Name)));
                header.CloseComponent();

                if (group.HeaderRightContent != null)
                {
                    header.AddContent(4, group.HeaderRightContent);
                }
            }));
            builder.CloseComponent();
        };
    }

    /// <summary>A group's own fields, laid out across its configured number of columns.</summary>
    private RenderFragment RenderFieldGroup(FieldGroup<TModel> group)
    {
        return builder =>
        {
            builder.OpenComponent<FluentGrid>(0);
            builder.AddAttribute(1, "ChildContent", (RenderFragment)(grid =>
            {
                var fieldsInGroup = Configuration.Fields
                    .Where(f => group.FieldNames.Contains(f.FieldName))
                    .OrderBy(f => f.Order);

                // Fluent's grid is 12 columns wide, like MudBlazor's, so a group asking for N
                // columns gives each field 12/N of the row. Clamped at 1: Columns is an int the
                // caller sets, and 0 or a negative would divide by zero or emit a nonsense span.
                var columnSize = 12 / Math.Max(1, group.Columns);

                foreach (var field in fieldsInGroup)
                {
                    if (!ShouldShowField(field))
                    {
                        continue;
                    }

                    grid.OpenComponent<FluentGridItem>(0);
                    grid.AddAttribute(1, "Xs", 12);
                    grid.AddAttribute(2, "Md", columnSize);
                    grid.AddAttribute(3, "ChildContent", RenderFieldWithMessages(field));
                    grid.CloseComponent();
                }
            }));
            builder.CloseComponent();
        };
    }

    /// <summary>Every visible field that no group claimed.</summary>
    private RenderFragment RenderUngroupedFields()
    {
        return builder =>
        {
            if (GroupedConfiguration == null)
            {
                return;
            }

            var groupedFieldNames = GroupedConfiguration.FieldGroups
                .SelectMany(g => g.FieldNames)
                .ToHashSet();

            var ungrouped = Configuration.Fields
                .Where(f => !groupedFieldNames.Contains(f.FieldName))
                .OrderBy(f => f.Order);

            foreach (var field in ungrouped)
            {
                if (!ShouldShowField(field))
                {
                    continue;
                }

                // Constant sequence numbers, NOT a running counter. Blazor's diff treats a sequence
                // number as a source position, so a counter that advances per iteration shifts
                // every later field's number the moment a VisibleWhen(...) field appears or
                // disappears - and the diff then rebuilds those subtrees instead of patching them,
                // discarding focus and component state in the fields below. Repeating 0/1 across
                // iterations is the documented pattern for loops, and is what RenderItemFields in
                // the collection component does.
                builder.OpenElement(0, "div");
                builder.AddContent(1, RenderFieldWithMessages(field));
                builder.CloseElement();
            }
        };
    }
}
