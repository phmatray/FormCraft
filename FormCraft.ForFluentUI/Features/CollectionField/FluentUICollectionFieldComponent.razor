@namespace FormCraft.ForFluentUI
@typeparam TModel where TModel : new()
@typeparam TItem where TItem : new()
@inject IFieldRendererService FieldRendererService

@if (Configuration.IsVisible)
{
    <FluentCard Class="formcraft-collection">
        @* tabindex="-1" makes the header programmatically focusable without joining the tab order:
           it is the last-resort focus target when a removal leaves the field with no control at all
           (#337, mirrors FormCraft.ForMudBlazor's _header). *@
        <div @ref="HeaderTarget" tabindex="-1">
            <FluentStack Orientation="Orientation.Horizontal"
                         HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                         VerticalAlignment="VerticalAlignment.Center">
                <FluentLabel Weight="LabelWeight.Semibold">@(Configuration.Label ?? Configuration.FieldName)</FluentLabel>
                @if (ShouldRenderAdd)
                {
                    @* FluentButton (the pinned v5 RC) exposes no FocusAsync()/ElementReference of its
                       own, so focus is restored through its Id and a small JS module instead of a
                       wrapping span (#383, see FocusRestore remarks). *@
                    <FluentButton Appearance="ButtonAppearance.Outline"
                                  Id="@AddTargetId"
                                  OnClick="@AddItem"
                                  data-testid="formcraft-collection-add">
                        @Configuration.AddButtonText
                    </FluentButton>
                }
            </FluentStack>
        </div>

        @if (Items.Count == 0)
        {
            @if (_bindingUnreadable)
            {
                @* Distinct from EmptyText (#433): a genuinely empty collection and one whose binding
                   cannot currently be read must never look identical to the user. *@
                <FluentMessageBar
                    Intent="MessageBarIntent.Warning"
                    AllowDismiss="false"
                    data-testid="formcraft-collection-unreadable">
                    @UnreadableBindingMessage
                </FluentMessageBar>
            }
            else
            {
                <FluentMessageBar Intent="MessageBarIntent.Info"
                                  AllowDismiss="false"
                                  data-testid="formcraft-collection-empty">
                    @Configuration.EmptyText
                </FluentMessageBar>
            }
        }
        else
        {
            @for (var i = 0; i < Items.Count; i++)
            {
                var index = i;
                var key = _rowIdentity.KeyFor(Items, index);
                @* #401 (porting #334), moved into core as CollectionRowIdentity (#422): the row's
                   ROOT element is keyed on the item's own identity - a weak token, never the item
                   itself. Keying on `Items[index]` was tried and reverted on the MudBlazor side
                   (#298/#308): Blazor matches keys by Equals, not by reference, and TItem is
                   constrained only to `new()`, so a record/struct row comparing equal to another was
                   a duplicate key. *@
                <FluentCard Class="formcraft-collection-item" data-testid="formcraft-collection-item" @key="key">
                    @* tabindex="-1" so a row can take focus without joining the tab order: it is
                       where focus goes when the acting control leaves no usable target - after Add
                       (the row's own fields render through IFieldRendererService and expose no
                       reference to aim at), and as the reorder fallback (#337). *@
                    <div @ref="_rowHeaderTargets[index]" tabindex="-1">
                        <FluentStack Orientation="Orientation.Horizontal"
                                     HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                                     VerticalAlignment="VerticalAlignment.Center">
                            <FluentLabel>Item @(index + 1)</FluentLabel>
                            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
                                @if (Configuration.CanReorder)
                                {
                                    <FluentButton Appearance="ButtonAppearance.Subtle"
                                                  Disabled="@(index == 0)"
                                                  Id="@MoveUpTargetIdAt(index)"
                                                  OnClick="@(() => MoveItemUp(index))"
                                                  aria-label="Move up"
                                                  data-testid="formcraft-collection-move-up">
                                        &#8593;
                                    </FluentButton>
                                    <FluentButton Appearance="ButtonAppearance.Subtle"
                                                  Disabled="@(index == Items.Count - 1)"
                                                  Id="@MoveDownTargetIdAt(index)"
                                                  OnClick="@(() => MoveItemDown(index))"
                                                  aria-label="Move down"
                                                  data-testid="formcraft-collection-move-down">
                                        &#8595;
                                    </FluentButton>
                                }
                            @if (DeleteTargetsRendered)
                            {
                                @* The id is deterministic per index (#383), so a removal can focus
                                   the control that takes the vacated slot - it is recomputed from
                                   today's Items on every render, independent of the row's own @key
                                   (#401), so the survivor at a given index always carries that
                                   index's id regardless of which row's component instance renders it. *@
                                <FluentButton Appearance="ButtonAppearance.Subtle"
                                              Id="@DeleteTargetIdAt(index)"
                                              OnClick="@(() => RemoveItem(index))"
                                              aria-label="Remove item"
                                              data-testid="formcraft-collection-remove">
                                    Remove
                                </FluentButton>
                            }
                            </FluentStack>
                        </FluentStack>
                    </div>

                    @if (Configuration.ItemFormConfiguration != null)
                    {
                        @* No CollectionItemFieldScope is cascaded here, unlike the MudBlazor
                           container. That type lives in FormCraft.ForMudBlazor (not core) and exists
                           for one job: keying and latching that adapter's ShrinkLabel diagnostics so
                           a 50-row collection reports a field's configuration once rather than 50
                           times. This adapter emits no such diagnostics and no Fluent component
                           reads the cascade, so copying the type over would cascade a value to
                           nobody.

                           When Fluent gains its own per-field diagnostics, this is where the scope
                           goes — and the MudBlazor original is the reference for two decisions worth
                           inheriting: the key is row-agnostic (`<collection>[].<field>`, #213),
                           and the CascadingValue must NOT be IsFixed, or the rebuilt scope would
                           never reach the item fields. *@
                        @RenderItemFields(index)
                    }
                </FluentCard>
            }
        }
    </FluentCard>
}
