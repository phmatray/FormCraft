@namespace FormCraft.ForFluentUI
@typeparam TModel
@inherits FluentUIFieldComponentBase<TModel, DateTime>

<FluentDatePicker TValue="DateTime?"
                  @bind-Value="@_localValue"
                  @bind-Value:after="OnLocalValueChanged"
                  Label="@Label"
                  Placeholder="@Placeholder"
                  Required="@EffectiveNativeRequired"
                  Disabled="@IsDisabled"
                  ReadOnly="@IsReadOnly"
                  aria-required="@AriaRequired" />
