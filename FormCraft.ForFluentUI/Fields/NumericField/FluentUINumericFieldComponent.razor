@namespace FormCraft.ForFluentUI
@typeparam TModel
@typeparam TValue where TValue : struct
@inherits FluentUIFieldComponentBase<TModel, TValue>

<FluentNumberInput TValue="TValue"
                   @bind-Value="@_localValue"
                   @bind-Value:after="OnLocalValueChanged"
                   Label="@Label"
                   Placeholder="@Placeholder"
                   Required="@EffectiveNativeRequired"
                   Disabled="@IsDisabled"
                   ReadOnly="@IsReadOnly"
                   Min="@(Min ?? NumericTypeDefaults<TValue>.Min)"
                   Max="@(Max ?? NumericTypeDefaults<TValue>.Max)"
                   Step="@(Step ?? NumericTypeDefaults<TValue>.Step)"
                   aria-describedby="@AriaDescribedBy"
                   @attributes="ExtraAttributes" />
