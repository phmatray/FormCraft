@namespace FormCraft.ForFluentUI
@typeparam TModel
@inherits FluentUIFieldComponentBase<TModel, bool>

@if (DisplayStyle == BooleanDisplayStyle.Switch)
{
    <FluentSwitch @bind-Value="@_localValue"
                  @bind-Value:after="OnLocalValueChanged"
                  Label="@Label"
                  Required="@EffectiveNativeRequired"
                  Disabled="@IsDisabled"
                  ReadOnly="@IsReadOnly"
                  aria-required="@AriaRequired" />
}
else
{
    <FluentCheckbox @bind-Value="@_localValue"
                    @bind-Value:after="OnLocalValueChanged"
                    Label="@Label"
                    Required="@EffectiveNativeRequired"
                    Disabled="@IsDisabled"
                    ReadOnly="@IsReadOnly"
                    aria-required="@AriaRequired" />
}
