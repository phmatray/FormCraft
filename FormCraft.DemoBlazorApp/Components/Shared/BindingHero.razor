@namespace FormCraft.DemoBlazorApp.Components.Shared
@inherits DemoComponentBase
@inject IJSRuntime JS

@*
    The home page's argument, played out: the source types itself on the left, and each field
    appears in a real FormCraftComponent on the right as its AddField statement completes. Then
    the form is filled in, validated (a bad email first), and submitted.

    The whole configuration is built once. What is "not written yet" is hidden by the rule in the
    <style> block below, so the form is never rebuilt mid-sequence, and the hidden lines and fields
    keep their space, so nothing on the page moves while it plays. Fields are hidden with opacity,
    not visibility: MudBlazor sets `visibility: visible` on parts of its inputs, which a child may.
*@
<div class="fc-hero-stage">
    <div class="fc-editor fc-hero-editor" data-code-host>
        <div class="fc-editor__tabs">
            <span class="fc-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="fc-tab is-on">
                <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 4L1.5 8 5 12M11 4l3.5 4-3.5 4" /></svg>
                Contact.razor
            </span>
            <button type="button" class="fc-copy" data-copy-code aria-label="Copy Contact.razor">
                <svg class="fc-i" viewBox="0 0 24 24" aria-hidden="true"><rect x="8.5" y="8.5" width="11" height="11" rx="2" /><path d="M15.5 8.5v-3a1 1 0 0 0-1-1h-9a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h3" /></svg>
            </button>
        </div>
        <pre class="fc-code" id="fc-hero-code" @ref="_codeHost"><code class="language-razor">@Source</code></pre>
        <div class="fc-editor__status">
            <span class="fc-live @(_phase >= 1 && _shownLines == LineCount ? "is-done" : null)"><i></i><span>@(_shownLines == LineCount ? "Built" : "Writing")</span></span>
            <span class="fc-sp"></span>
            <span>Razor · C#</span>
            <span>Ln @Math.Max(1, _shownLines)</span>
        </div>
    </div>

    <div class="fc-stage__form fc-hero-right">
        <div class="fc-formpanel" id="fc-hero-form">
            <div class="fc-formpanel__head">
                <b>Contact us</b>
                <span class="fc-chip-rendered">rendered by FormCraft</span>
            </div>
            <FormCraftComponent @key="_formKey"
                                @ref="_form"
                                TModel="Contact"
                                Model="@_model"
                                Configuration="@_configuration"
                                OnValidSubmit="@HandleSubmit"
                                SubmitButtonText="Send" />
            @if (_result is not null)
            {
                <div class="fc-result @(_resultIsError ? "is-err" : null)" role="status">
                    @if (_resultIsError)
                    {
                        <svg class="fc-i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7.5v5.5M12 16.5v.01" /></svg>
                    }
                    else
                    {
                        <svg class="fc-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                    }
                    <span>@_result</span>
                </div>
            }
        </div>

        <div class="fc-hero-controls">
            <button type="button" class="fc-ctl" aria-pressed="@(_paused ? "true" : "false")" @onclick="TogglePause">
                @if (_paused)
                {
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5l12 7-12 7z" /></svg>
                    <span>Play</span>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
                    <span>Pause</span>
                }
            </button>
            <button type="button" class="fc-ctl" @onclick="Replay">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4.5h4.5" /></svg>
                <span>Replay</span>
            </button>
            <button type="button" class="fc-ctl" @onclick="SkipAsync"><span>Skip to the result</span></button>
        </div>
    </div>
</div>

<ol class="fc-phases" aria-label="What the demo above is doing">
    @for (var i = 0; i < Phases.Length; i++)
    {
        <li class="fc-phase @(i == _phase ? "is-on" : i < _phase ? "is-done" : null)">
            <b>@Phases[i].Title</b>
            <span>@((MarkupString)Phases[i].Detail)</span>
        </li>
    }
</ol>

<style>
    #fc-hero-code .cl:nth-child(n + @(_shownLines + 1)) { visibility: hidden; }
    #fc-hero-code .cl:nth-child(@_shownLines) { animation: fc-type .45s steps(28, end); }
    #fc-hero-form form > div:nth-of-type(n + @(_shownFields + 1)) { opacity: 0; pointer-events: none; }
    #fc-hero-form form > div:nth-of-type(@_shownFields) { animation: fc-field-in .7s var(--fc-ease); }
    @SubmitRule
</style>
