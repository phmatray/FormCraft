@namespace FormCraft.DemoBlazorApp.Components.Shared.Navigation
@inject IDemoRegistry DemoRegistry

@if (_currentDemo is not null)
{
    <nav class="fc-crumbs" aria-label="Breadcrumb">
        <ol>
            <li><a href="">Overview</a></li>
            <li><a href="simplified">Demos</a></li>
            <li aria-current="page">@_currentDemo.Title</li>
        </ol>

        @if (!string.IsNullOrEmpty(_currentDemo.Level))
        {
            <span class="fc-crumbs__meta">
                <LevelMeter Level="@_currentDemo.Level" />
                @if (_currentDemo.EstimatedMinutes > 0)
                {
                    <span>@_currentDemo.EstimatedMinutes min</span>
                }
            </span>
        }
    </nav>
}
