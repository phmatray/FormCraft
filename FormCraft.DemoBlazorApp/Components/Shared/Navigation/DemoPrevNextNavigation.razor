@namespace FormCraft.DemoBlazorApp.Components.Shared.Navigation
@inject IDemoRegistry DemoRegistry

@if (_previous != null || _next != null)
{
    <nav class="fc-prevnext" aria-label="Demo navigation">
        @if (_previous != null)
        {
            <a class="fc-prevnext__link" href="@_previous.Id">
                <span class="fc-prevnext__dir">← Previous</span>
                <span class="fc-prevnext__title">@_previous.Title</span>
            </a>
        }
        else
        {
            <span class="fc-prevnext__link" aria-hidden="true"></span>
        }

        @if (_next != null)
        {
            <a class="fc-prevnext__link fc-prevnext__link--next" href="@_next.Id">
                @* When the next demo starts a new level, say so — that is the one piece
                   of information the reader cannot get from the title alone. *@
                <span class="fc-prevnext__dir">
                    @(_isLevelTransition && _nextLevelInfo is not null
                        ? $"Next — starts the {_nextLevelInfo.Value.Name} track"
                        : "Next →")
                </span>
                <span class="fc-prevnext__title">@_next.Title</span>
            </a>
        }
    </nav>
}
