@inherits DemoComponentBase
@inject IJSRuntime JsRuntime

<div class="fc-editor @Class" data-code-host @ref="_element">
    <div class="fc-editor__tabs">
        <span class="fc-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="fc-tab is-on">
            <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 4L1.5 8 5 12M11 4l3.5 4-3.5 4" /></svg>
            @Title
        </span>
        <button type="button" class="fc-copy" data-copy-code aria-label="Copy code">
            <svg class="fc-i" viewBox="0 0 24 24" aria-hidden="true"><rect x="8.5" y="8.5" width="11" height="11" rx="2" /><path d="M15.5 8.5v-3a1 1 0 0 0-1-1h-9a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h3" /></svg>
        </button>
    </div>
    @* Keyed on the code: js/code.js rewrites this element's content into lines, so a change must
       replace the element rather than patch a text node Blazor no longer owns. *@
    <pre class="fc-code @(ShowLineNumbers ? null : "fc-code--plain")"><code @key="Code" class="language-@Language">@Code</code></pre>
    <div class="fc-editor__status">
        <span class="fc-live is-done"><i></i><span>Runs as shown</span></span>
        <span class="fc-sp"></span>
        <span>@GetLanguageLabel()</span>
    </div>
</div>
