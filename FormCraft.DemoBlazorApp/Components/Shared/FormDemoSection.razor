@namespace FormCraft.DemoBlazorApp.Components.Shared
@typeparam TModel where TModel : new()

<div class="fc-formpanel__head">
    <b>@FormTitle</b>
    <span class="fc-chip-rendered">rendered by FormCraft</span>
</div>

@if (IsSubmitted)
{
    <FormSuccessDisplay
        DataDisplayItems="@DataDisplayItems"
        OnReset="@OnReset" />
}
else if (Configuration == null)
{
    <SkeletonLoader />
}
else
{
    <FormCraftComponent
        TModel="TModel"
        Model="@Model"
        Configuration="@Configuration"
        OnValidSubmit="@OnValidSubmit"
        OnFieldChanged="@OnFieldChanged"
        IsSubmitting="@IsSubmitting"
        ShowSubmitButton="@ShowSubmitButton"
        SubmitButtonText="@SubmitButtonText"
        SubmittingText="@SubmittingText"
        SubmitButtonClass="@SubmitButtonClass">
        <BeforeForm>
            @BeforeFormContent
        </BeforeForm>
        <AfterForm>
            @AfterFormContent
        </AfterForm>
    </FormCraftComponent>

    @* Notes read on the dark stage below the source and the form, not inside the form's panel. *@
    <SectionContent SectionName="demo-notes">
        @AdditionalContent
    </SectionContent>
}

@if (ShowSidebar && SidebarContent is not null)
{
    <SectionContent SectionName="demo-aside">
        @SidebarContent
    </SectionContent>
}
