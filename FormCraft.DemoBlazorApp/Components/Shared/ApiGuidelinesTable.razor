@namespace FormCraft.DemoBlazorApp.Components.Shared
@inject IJSRuntime JsRuntime

@* Two cards a row: the method, what it does, and a one-line example, highlighted like the stage. *@
<div class="fc-apis" @ref="_element">
    @foreach (var item in Items)
    {
        <div class="fc-api">
            <b>@item.Feature</b>
            <span>@item.Usage</span>
            @if (!string.IsNullOrEmpty(item.Example))
            {
                @if (item.IsCode)
                {
                    <pre class="fc-code fc-code--plain fc-api__ex"><code class="language-@(item.Example.TrimStart().StartsWith('<') ? "razor" : "csharp")">@item.Example</code></pre>
                }
                else
                {
                    <span class="fc-api__note">@item.Example</span>
                }
            }
        </div>
    }
</div>

@AdditionalContent
