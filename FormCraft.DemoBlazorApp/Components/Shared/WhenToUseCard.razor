@namespace FormCraft.DemoBlazorApp.Components.Shared

@if (!string.IsNullOrWhiteSpace(Text))
{
    <section class="fc-note fc-note--when" aria-labelledby="when-to-use">
        <h2 class="fc-note__title" id="when-to-use">When to use it</h2>
        <p class="fc-pull">@Text</p>
    </section>
}

@code {
    [Parameter]
    public string? Text { get; set; }
}
