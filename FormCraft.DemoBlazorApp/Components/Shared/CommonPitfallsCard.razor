@namespace FormCraft.DemoBlazorApp.Components.Shared

@if (Pitfalls is { Count: > 0 })
{
    <section class="fc-note fc-note--pitfalls" aria-labelledby="pitfalls">
        <h2 class="fc-note__title" id="pitfalls">
            <svg class="fc-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            Pitfalls
        </h2>
        <ul class="fc-pitfalls">
            @foreach (var pitfall in Pitfalls)
            {
                <li>@pitfall</li>
            }
        </ul>
    </section>
}

@code {
    [Parameter]
    public IReadOnlyList<string>? Pitfalls { get; set; }
}
