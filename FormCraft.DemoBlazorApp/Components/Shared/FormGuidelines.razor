@* The demo's feature list, shown under the form on the colour field. *@
<section class="fc-aside-card" aria-label="@Title">
    <h2 class="fc-aside-card__title">@Title</h2>
    @if (ChildContent != null)
    {
        @ChildContent
    }
    else if (Guidelines.Any())
    {
        <ul class="fc-aside-list">
            @foreach (var guideline in Guidelines)
            {
                <li>
                    <svg class="fc-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                    @guideline.Text
                </li>
            }
        </ul>
    }
</section>
