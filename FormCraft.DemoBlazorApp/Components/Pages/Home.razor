@page "/"
@page "/home"
@inject IJSRuntime JS

<PageTitle>FormCraft — dynamic forms for Blazor</PageTitle>

@* ----------------------------------------------------------------------------
   Hero. The thesis is the transform, so the transform is the hero: a builder
   chain and the form it produced, tied together.
   ---------------------------------------------------------------------------- *@
<section class="fc-page fc-band fc-hero">
    <div class="fc-hero__intro">
        <span class="fc-eyebrow">FormBuilder&lt;T&gt;</span>
        <h1 class="fc-hero__title">
            Describe the form in C#.
            <em>FormCraft renders it.</em>
        </h1>
        <p class="fc-lede">
            One typed builder chain produces the fields, the validation and the MudBlazor markup.
            Add a line, get a control — hover either side below to see the pairing.
        </p>

        <div class="fc-hero__actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Href="simplified">
                Browse the demos
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" Href="docs/getting-started">
                Read the docs
            </MudButton>
        </div>

        <div class="fc-install">
            <span class="fc-install__prompt">$</span>
            <span>dotnet add package FormCraft.ForMudBlazor</span>
            <MudTooltip Text="@(_copiedInstall ? "Copied" : "Copy")">
                <MudIconButton Icon="@(_copiedInstall ? Icons.Material.Filled.Check : Icons.Material.Filled.ContentCopy)"
                               Color="@(_copiedInstall ? Color.Success : Color.Default)"
                               Size="Size.Small"
                               aria-label="Copy the install command"
                               OnClick="CopyInstall" />
            </MudTooltip>
        </div>
    </div>

    <BindingHero />

    @* Facts an evaluating developer actually checks, in the same mono as every
       other API-shaped label on the site. The test figure is a lower bound on
       purpose: an exact count goes stale the next time anyone adds a test.
       Measured at 1,134 passing on this branch (dotnet test). *@
    <dl class="fc-spec">
        <div class="fc-spec__item"><dt>targets</dt><dd class="fc-spec__value">net8.0 · net10.0</dd></div>
        <div class="fc-spec__item"><dt>tests</dt><dd class="fc-spec__value">1,100+</dd></div>
        <div class="fc-spec__item"><dt>licence</dt><dd class="fc-spec__value">MIT</dd></div>
        <div class="fc-spec__item"><dt>ui</dt><dd class="fc-spec__value">MudBlazor 9</dd></div>
    </dl>
</section>

@* ----------------------------------------------------------------------------
   Capabilities. Each entry names the API that does the job and links to the demo
   that proves it, so the section is a route into the site rather than a poster.
   ---------------------------------------------------------------------------- *@
<section class="fc-page fc-band">
    <header class="fc-section-head">
        <span class="fc-eyebrow">What it covers</span>
        <h2 class="fc-section-title">Everything a real form needs, typed.</h2>
        <p class="fc-lede">
            Each of these is one call on the builder. Follow any of them into a working demo.
        </p>
    </header>

    <div class="fc-caps">
        <a class="fc-cap" href="fluent-validation-demo">
            <code class="fc-cap__api">.Required() · .WithValidator()</code>
            <h3 class="fc-cap__title">Validation on the server, not the browser</h3>
            <p class="fc-cap__body">
                Built-in rules, custom validators and FluentValidation, all running against your model.
            </p>
        </a>

        <a class="fc-cap" href="complex-dependencies">
            <code class="fc-cap__api">.DependsOn()</code>
            <h3 class="fc-cap__title">Fields that answer to other fields</h3>
            <p class="fc-cap__body">
                Show, hide or recalculate a field when the values it depends on change.
            </p>
        </a>

        <a class="fc-cap" href="field-groups">
            <code class="fc-cap__api">.AddFieldGroup()</code>
            <h3 class="fc-cap__title">Groups, columns and cards</h3>
            <p class="fc-cap__body">
                Arrange fields into labelled sections with their own column counts and layout.
            </p>
        </a>

        <a class="fc-cap" href="custom-renderers">
            <code class="fc-cap__api">.WithCustomRenderer()</code>
            <h3 class="fc-cap__title">Your own controls</h3>
            <p class="fc-cap__body">
                Swap in any Blazor component for a field type the library does not ship.
            </p>
        </a>

        <a class="fc-cap" href="attribute-based-forms">
            <code class="fc-cap__api">.AddFieldsFromAttributes()</code>
            <h3 class="fc-cap__title">Forms straight from the model</h3>
            <p class="fc-cap__body">
                Annotate properties and let the builder derive the fields for you.
            </p>
        </a>

        <a class="fc-cap" href="security-demo">
            <code class="fc-cap__api">.WithSecurity()</code>
            <h3 class="fc-cap__title">Encryption, CSRF and rate limits</h3>
            <p class="fc-cap__body">
                Encrypt named fields, issue CSRF tokens and throttle submissions from the same chain.
            </p>
        </a>
    </div>
</section>

@* ----------------------------------------------------------------------------
   Quick start. Numbered because this genuinely is a sequence — the numbers carry
   order the reader needs, which is the only reason to use them.
   ---------------------------------------------------------------------------- *@
<section class="fc-band fc-band--tint">
    <div class="fc-page">
        <header class="fc-section-head">
            <span class="fc-eyebrow">Quick start</span>
            <h2 class="fc-section-title">Three steps to a working form.</h2>
        </header>

        <ol class="fc-steps">
            <li class="fc-step">
                <span class="fc-step__num">01</span>
                <div>
                    <h3 class="fc-step__title">Install the package</h3>
                    <pre>dotnet add package FormCraft.ForMudBlazor</pre>
                </div>
            </li>

            <li class="fc-step">
                <span class="fc-step__num">02</span>
                <div>
                    <h3 class="fc-step__title">Register the services</h3>
                    <pre>builder.Services.AddMudServices();
builder.Services.AddFormCraftForMudBlazor();</pre>
                </div>
            </li>

            <li class="fc-step">
                <span class="fc-step__num">03</span>
                <div>
                    <h3 class="fc-step__title">Build a form and render it</h3>
                    <pre>var config = FormBuilder&lt;Contact&gt;.Create()
    .AddRequiredTextField(x =&gt; x.Name, "Name")
    .AddEmailField(x =&gt; x.Email)
    .Build();

&lt;FormCraftComponent TModel="Contact"
                    Model="@@model"
                    Configuration="@@config" /&gt;</pre>
                </div>
            </li>
        </ol>
    </div>
</section>

@* ---------------------------------------------------------------------------- *@
<section class="fc-page fc-band">
    <div class="fc-cta">
        <h2 class="fc-cta__title">Start with the beginner track.</h2>
        <p class="fc-cta__body">
            Twenty demos, ordered from a five-line contact form to master-detail collections,
            security and custom renderers. Each one ships its source alongside it.
        </p>
        <div class="fc-cta__actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Href="simplified">
                Open the first demo
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Inherit"
                       Size="Size.Large"
                       Style="color: #F5F4F8; border-color: rgba(255,255,255,.35);"
                       Href="https://github.com/phmatray/FormCraft"
                       Target="_blank">
                View the source
            </MudButton>
        </div>
    </div>
</section>
