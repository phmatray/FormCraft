@inherits LayoutComponentBase
@using FormCraft.DemoBlazorApp.Components.Shared.Navigation
@inject IVersionService VersionService
@inject IDemoRegistry DemoRegistry
@inject NavigationManager Navigation
@inject IJSRuntime JS

<MudThemeProvider Theme="_theme" IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<a class="fc-skip-link" href="#main-content">Skip to content</a>

<MudLayout>
    <MudAppBar Elevation="0" Dense="false" Class="fc-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       aria-label="Toggle navigation"
                       OnClick="@ToggleDrawer" />

        <MudLink Class="d-flex align-center ml-2 me-2"
                 Style="text-decoration: none; cursor: pointer;"
                 @onclick="NavigateToHome">
            <span class="fc-wordmark">FormCraft</span>
        </MudLink>
        <span class="fc-version">v@_version</span>

        <MudSpacer />

        <button type="button" class="fc-search-trigger" @onclick="OpenPaletteFromToolbar">
            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
            <span class="fc-search-trigger__label">Search demos</span>
            <kbd class="fc-kbd">⌘K</kbd>
        </button>

        <MudTooltip Text="@(_isDarkMode ? "Switch to light theme" : "Switch to dark theme")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           aria-label="@(_isDarkMode ? "Switch to light theme" : "Switch to dark theme")"
                           Class="ml-1"
                           OnClick="@ToggleTheme" />
        </MudTooltip>

        <MudTooltip Text="FormCraft on GitHub">
            <MudIconButton Icon="@Icons.Custom.Brands.GitHub"
                           Color="Color.Inherit"
                           aria-label="FormCraft on GitHub"
                           Href="https://github.com/phmatray/FormCraft"
                           Target="_blank" />
        </MudTooltip>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Href="docs/getting-started"
                   Class="ml-2 d-none d-sm-flex">
            Get started
        </MudButton>
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="0"
               Breakpoint="Breakpoint.Md"
               Variant="DrawerVariant.Responsive"
               Class="fc-drawer">
        <MudNavMenu>
            <MudNavLink Href="home" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
                Overview
            </MudNavLink>

            @foreach (var level in _levels)
            {
                var levelInfo = DemoRegistry.GetLevelInfo(level);
                var demos = DemoRegistry.GetDemosByLevel(level);

                <MudNavGroup Title="@levelInfo.Name"
                             Icon="@levelInfo.Icon"
                             Expanded="@(level == Services.DemoRegistry.Levels.Beginner)">
                    <div class="fc-drawer-heading">
                        <span class="fc-drawer-heading__sub">@GetLevelSubtitle(level)</span>
                        <span class="fc-drawer-heading__count">@demos.Count</span>
                    </div>
                    @foreach (var demo in demos)
                    {
                        <MudNavLink Href="@demo.Id" Icon="@demo.Icon">
                            <div class="d-flex align-center justify-space-between" style="gap: .5rem;">
                                <span>@demo.Title</span>
                                @if (demo.IsLevelEntryPoint && level == Services.DemoRegistry.Levels.Beginner)
                                {
                                    <span class="fc-start-tag">Start</span>
                                }
                            </div>
                        </MudNavLink>
                    }
                </MudNavGroup>
            }

            <MudNavGroup Title="Documentation" Icon="@Icons.Material.Filled.MenuBook" Expanded="false">
                @foreach (var doc in DemoRegistry.GetDemosByCategory("documentation"))
                {
                    <MudNavLink Href="@doc.Id" Icon="@doc.Icon">
                        @doc.Title
                    </MudNavLink>
                }
            </MudNavGroup>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <div id="main-content" tabindex="-1">
            @Body
        </div>

        <footer class="fc-footer">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge">
                <div class="fc-footer__inner">
                    <div>
                        <div class="fc-footer__mark">FormCraft</div>
                        <div class="fc-footer__meta">v@_version · MIT · net8.0 · net10.0</div>
                    </div>
                    <nav class="fc-footer__links" aria-label="Footer">
                        <a href="docs/getting-started">Documentation</a>
                        <a href="https://github.com/phmatray/FormCraft" target="_blank" rel="noopener">GitHub</a>
                        <a href="https://www.nuget.org/packages/FormCraft" target="_blank" rel="noopener">NuGet</a>
                        <a href="https://github.com/phmatray/FormCraft/issues" target="_blank" rel="noopener">Report an issue</a>
                    </nav>
                </div>
            </MudContainer>
        </footer>
    </MudMainContent>

    <MudScrollToTop>
        <MudFab Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.KeyboardArrowUp"
                aria-label="Back to top" />
    </MudScrollToTop>
</MudLayout>

<CommandPalette @bind-Open="_paletteOpen" />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
