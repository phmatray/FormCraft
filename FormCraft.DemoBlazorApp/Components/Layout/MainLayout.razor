@inherits LayoutComponentBase
@using FormCraft.DemoBlazorApp.Components.Shared.Navigation
@inject IVersionService VersionService
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* Forms keep MudBlazor's light palette: they sit on light panels, the way they look in a
   visitor's own app. The dark stage around them is the site's own CSS (css/tokens.css). *@
<MudThemeProvider Theme="_theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="fc-shell">
    <a class="fc-skip-link" href="#main-content">Skip to content</a>

    <header class="fc-nav">
        <div class="fc-wrap fc-nav__row">
            <a class="fc-brand" href="" aria-label="FormCraft home">
                <svg viewBox="0 0 32 32" aria-hidden="true">
                    <rect x="2" y="2" width="28" height="28" rx="8" fill="var(--fc-violet)" />
                    <rect x="8" y="9" width="16" height="3.2" rx="1.6" fill="#fff" />
                    <rect x="8" y="15" width="11" height="3.2" rx="1.6" fill="var(--fc-yellow)" />
                    <rect x="8" y="21" width="7" height="3.2" rx="1.6" fill="var(--fc-mint)" />
                </svg>
                FormCraft
                <span class="fc-brand__version">v@_version</span>
            </a>

            <nav class="fc-nav__links" aria-label="Primary">
                <a href="" class="@ActiveFor(Section.Home)">Overview</a>
                <a href="simplified" class="@ActiveFor(Section.Demos)">Demos</a>
                <a href="docs/getting-started" class="@ActiveFor(Section.Docs)">Docs</a>
                <a href="docs/api-reference" class="@ActiveFor(Section.Api)">API</a>
            </nav>

            <div class="fc-nav__spacer"></div>

            <button type="button" class="fc-search" aria-label="Search demos" @onclick="OpenPaletteFromToolbar">
                <svg class="fc-i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" /></svg>
                <span>Search demos</span>
                <kbd class="fc-kbd">@ShortcutHint</kbd>
            </button>

            <a class="fc-iconbtn" href="https://github.com/phmatray/FormCraft" target="_blank" rel="noopener" aria-label="FormCraft on GitHub">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z" /></svg>
            </a>

            <a class="fc-btn fc-btn--primary fc-btn--sm" href="docs/getting-started">Get started</a>
        </div>
    </header>

    <main id="main-content" class="fc-main" tabindex="-1">
        @Body
    </main>

    <footer class="fc-wrap fc-foot">
        <div class="fc-foot__row">
            <span>FormCraft v@_version · MIT licence · net8.0 · net10.0</span>
            <nav aria-label="Footer">
                <a href="docs/getting-started">Docs</a>
                <a href="https://github.com/phmatray/FormCraft" target="_blank" rel="noopener">GitHub</a>
                <a href="https://www.nuget.org/packages/FormCraft" target="_blank" rel="noopener">NuGet</a>
                <a href="https://github.com/phmatray/FormCraft/blob/dev/LICENSE" target="_blank" rel="noopener">Licence</a>
                <a href="https://github.com/phmatray/FormCraft/issues" target="_blank" rel="noopener">Report an issue</a>
            </nav>
        </div>
    </footer>
</div>

<CommandPalette @bind-Open="_paletteOpen" />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
