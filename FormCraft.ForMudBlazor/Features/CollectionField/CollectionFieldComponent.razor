@namespace FormCraft.ForMudBlazor
@typeparam TModel where TModel : new()
@typeparam TItem where TItem : new()
@inject IFieldRendererService FieldRendererService

@if (Configuration.IsVisible)
{
    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <div class="d-flex justify-space-between align-center mb-3">
            <MudText Typo="Typo.h6">@(Configuration.Label ?? Configuration.FieldName)</MudText>
            @if (Configuration.CanAdd && !HasReachedMax)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           Size="Size.Small"
                           OnClick="@AddItem">
                    @Configuration.AddButtonText
                </MudButton>
            }
        </div>

        @if (Items.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mb-2">
                @Configuration.EmptyText
            </MudAlert>
        }
        else
        {
            @for (var i = 0; i < Items.Count; i++)
            {
                var index = i;
                @* ⛔ Deliberately NOT keyed. #298 tried `@key="Items[index]"` and reverted it: Blazor
                   matches keys by Equals, not by reference, and TItem is constrained only to `new()`.
                   For a record or struct item type — or any class overriding Equals — two rows with
                   equal content are a duplicate key, and RenderTreeDiffBuilder throws
                   "More than one sibling ... has the same key value". `AddItem()` adds `new TItem()`,
                   so on a record-typed item form clicking "Add item" twice was enough to crash the
                   render before the user typed anything.

                   Keying on the index instead is what a keyless loop already does, so it buys
                   nothing. A correct key needs a per-row identity independent of item equality, and
                   the obvious candidates do not survive the fact that `Items` IS the caller's model
                   list and can be mutated from outside this component entirely. That is real work
                   with a real design question behind it, so it is filed rather than guessed at.

                   What positional matching costs is component IDENTITY, not displayed values: those
                   already reload via FieldComponentBase.ShouldReloadValue(). *@
                <MudCard Class="mb-3" Elevation="0" Outlined="true">
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-center mb-2">
                            <MudText Typo="Typo.subtitle2" Color="Color.Default">
                                Item @(index + 1)
                            </MudText>
                            <div class="d-flex gap-1">
                                @if (Configuration.CanReorder)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                                   Size="Size.Small"
                                                   Disabled="@(index == 0)"
                                                   OnClick="@(() => MoveItemUp(index))"
                                                   aria-label="Move up" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                                   Size="Size.Small"
                                                   Disabled="@(index == Items.Count - 1)"
                                                   OnClick="@(() => MoveItemDown(index))"
                                                   aria-label="Move down" />
                                }
                                @if (Configuration.CanRemove && !HasReachedMin)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => RemoveItem(index))"
                                                   aria-label="Remove item" />
                                }
                            </div>
                        </div>
                        @if (Configuration.ItemFormConfiguration != null)
                        {
                            @* The nested context every item field renders in (#203): it names the
                               owning collection, so form-wide diagnostics can tell an item "Name"
                               apart from a top-level one, and carries the once-per-field latch that
                               keeps a 50-row collection from emitting 50 identical warnings.

                               Deliberately NOT IsFixed. One scope instance does serve the whole
                               collection for this component's lifetime in the normal case — which is
                               what makes the latch work — but OnParametersSet rebuilds it if the
                               component is ever re-pointed at a different collection field, and a
                               fixed CascadingValue registers no subscribers, so that replacement
                               would never reach the item fields. They would keep reporting
                               diagnostics under the previous collection's key. The two settings
                               contradict each other; correctness wins over the saved subscriptions. *@
                            <CascadingValue TValue="CollectionItemFieldScope"
                                            Name="@FormCraftCascadingValues.ItemFieldScope"
                                            Value="@_itemFieldScope">
                                @RenderItemFields(index)
                            </CascadingValue>
                        }
                    </MudCardContent>
                </MudCard>
            }
        }

        @if (ValidationErrors.Any())
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="mt-2">
                <ul class="mb-0">
                    @foreach (var error in ValidationErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </MudAlert>
        }
    </MudPaper>
}
