@namespace FormCraft.ForMudBlazor
@typeparam TModel where TModel : new()
@typeparam TItem where TItem : new()
@inject IFieldRendererService FieldRendererService

@if (Configuration.IsVisible)
{
    <MudPaper Class="pa-4 mb-4" Outlined="true">
        @* tabindex="-1" makes the header programmatically focusable without putting it in the tab
           order: it is the last-resort focus target when an action leaves the field with no button
           at all (#318). It carries the collection's label, so landing here is announced. *@
        <div class="d-flex justify-space-between align-center mb-3" @ref="_header" tabindex="-1">
            <MudText Typo="Typo.h6">@(Configuration.Label ?? Configuration.FieldName)</MudText>
            @if (Configuration.CanAdd && !HasReachedMax)
            {
                <MudButton @ref="_addButton"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           Size="Size.Small"
                           OnClick="@AddItem">
                    @Configuration.AddButtonText
                </MudButton>
            }
        </div>

        @if (Items.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mb-2">
                @Configuration.EmptyText
            </MudAlert>
        }
        else
        {
            @for (var i = 0; i < Items.Count; i++)
            {
                var index = i;
                var key = RowKey(index);
                @* #334: the row's ROOT element is keyed on the item's own identity — a weak token,
                   never the item itself. #298 tried `@key="Items[index]"` and reverted it: Blazor
                   matches keys by Equals, not by reference, and TItem is constrained only to `new()`.
                   For a record or struct item type — or any class overriding Equals — two rows with
                   equal content were a duplicate key, and RenderTreeDiffBuilder threw
                   "More than one sibling ... has the same key value". `RowKey` sidesteps that
                   entirely: a reference-type item gets a fresh, reference-compared token from
                   ConditionalWeakTable, so two equal-by-value rows still get two different keys, and
                   the token follows its item across an add/remove/reorder — even one this component
                   was never told about, since `Items` IS the caller's own model list. A value-typed
                   item — which boxes fresh on every access, so has no reference-stable identity to
                   hand the weak table — falls back to the boxed index, which reconciles identically
                   to today's unkeyed loop.

                   The row's CHROME below (header, reorder/delete buttons) is deliberately keyed the
                   SAME way, and the focus-restore dictionaries (_rowHeaders, _deleteButtons, etc.)
                   are keyed by that same RowKey rather than by plain index — see their doc comments.
                   A `@ref` on a component fires only once, at creation, so once the row's subtree can
                   MOVE with its item instead of staying pinned to a position, an index-keyed
                   dictionary would go stale the moment a row moved; keying the dictionaries by the
                   identical value keeps "the button for the row now at index N" and "the button
                   Blazor actually put there" the same lookup. *@
                <MudCard Class="mb-3" Elevation="0" Outlined="true" @key="key">
                    <MudCardContent>
                        @* tabindex="-1" so a row can take focus without joining the tab order: it is
                           where focus goes when the acting control leaves no usable target — after
                           Add (the row's own fields render through IFieldRendererService and expose
                           no reference to aim at, and landing on Delete would put Enter on "undo the
                           add"), and as the reorder fallback (#318). *@
                        <div class="d-flex justify-space-between align-center mb-2"
                             @ref="_rowHeaders[key]"
                             tabindex="-1">
                            <MudText Typo="Typo.subtitle2" Color="Color.Default">
                                Item @(index + 1)
                            </MudText>
                            <div class="d-flex gap-1">
                                @if (Configuration.CanReorder)
                                {
                                    <MudIconButton @ref="_moveUpButtons[key]"
                                                   Icon="@Icons.Material.Filled.ArrowUpward"
                                                   Size="Size.Small"
                                                   Disabled="@(index == 0)"
                                                   OnClick="@(() => MoveItemUp(index))"
                                                   aria-label="Move up" />
                                    <MudIconButton @ref="_moveDownButtons[key]"
                                                   Icon="@Icons.Material.Filled.ArrowDownward"
                                                   Size="Size.Small"
                                                   Disabled="@(index == Items.Count - 1)"
                                                   OnClick="@(() => MoveItemDown(index))"
                                                   aria-label="Move down" />
                                }
                                @if (Configuration.CanRemove && !HasReachedMin)
                                {
                                    @* Captured per row so a removal can focus the button that takes
                                       the vacated slot — keyed by RowKey, which follows the row's
                                       item across a move rather than staying pinned to a position
                                       (#318, #334). *@
                                    <MudIconButton @ref="_deleteButtons[key]"
                                                   Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => RemoveItem(index))"
                                                   aria-label="Remove item" />
                                }
                            </div>
                        </div>
                        @if (Configuration.ItemFormConfiguration != null)
                        {
                            @* The nested context every item field renders in (#203): it names the
                               owning collection, so form-wide diagnostics can tell an item "Name"
                               apart from a top-level one, and carries the once-per-field latch that
                               keeps a 50-row collection from emitting 50 identical warnings.

                               Deliberately NOT IsFixed. One scope instance does serve the whole
                               collection for this component's lifetime in the normal case — which is
                               what makes the latch work — but OnParametersSet rebuilds it if the
                               component is ever re-pointed at a different collection field, and a
                               fixed CascadingValue registers no subscribers, so that replacement
                               would never reach the item fields. They would keep reporting
                               diagnostics under the previous collection's key. The two settings
                               contradict each other; correctness wins over the saved subscriptions. *@
                            <CascadingValue TValue="CollectionItemFieldScope"
                                            Name="@FormCraftCascadingValues.ItemFieldScope"
                                            Value="@_itemFieldScope">
                                @RenderItemFields(index)
                            </CascadingValue>
                        }
                    </MudCardContent>
                </MudCard>
            }
        }

        @if (ValidationErrors.Any())
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="mt-2">
                <ul class="mb-0">
                    @foreach (var error in ValidationErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </MudAlert>
        }
    </MudPaper>
}
