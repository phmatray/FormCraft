@namespace FormCraft.ForMudBlazor
@typeparam TModel
@inherits MudBlazorFileUploadComponentBase<TModel, IReadOnlyList<IBrowserFile>?>

@if (HasLabel)
{
    <MudText Typo="Typo.body2" Class="mb-1">
        @Label@if (NativeRequiredValue)
        {
            <FileUploadRequiredMarker />
        }
    </MudText>
}

<MudFileUpload @ref="@_fileUpload"
               T="IReadOnlyList<IBrowserFile>"
               Files="@CurrentValue"
               FilesChanged="@OnFilesChanged"
               Accept="@Accept"
               MaximumFileCount="@MaxFiles"
               Class="relative"
               InputClass="mud-file-upload-dragover"
               SelectedTemplate="@SuppressBuiltInFileList"
               ErrorText="@string.Empty"
               tabindex="-1"
               aria-label="@FileInputAccessibleName"
               Hidden="@(!_dragging)"
               OnDrop="@ClearDragClass"
               OnDragLeave="@ClearDragClass"
               OnDragEnd="@ClearDragClass">
    <CustomContent>
        @* Entering the zone unhides the capture input for the drop (see _dragging); the click that
           "or click" promises opens the picker here, as Browse does. *@
        <MudPaper Height="@GetHeight()"
                  Outlined="true"
                  Class="@_dragClass"
                  Style="cursor: pointer"
                  @ondragenter="@SetDragClass"
                  @onclick="@OpenFilePickerAsync">
            <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mud-height-full">
                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6" Align="Align.Center">
                    @if (CurrentValue?.Any() == true)
                    {
                        @($"{CurrentValue.Count} file(s) selected")
                    }
                    else
                    {
                        @("Drag and drop files here or click")
                    }
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @($"Max {MaxFiles} files • {FormatFileSize(MaxFileSize ?? 0)} per file")
                </MudText>
                @if (CurrentValue?.Any() == true)
                {
                    <MudStack Row Wrap="Wrap.Wrap" Justify="Justify.Center" Class="mt-2">
                        @foreach (var file in CurrentValue.Take(3))
                        {
                            <MudChip T="string" 
                                   Color="Color.Primary" 
                                   Text="@($"{file.Name} ({FormatFileSize(file.Size)})")"
                                   OnClose="@(() => RemoveFile(file))"
                                   CloseIcon="@Icons.Material.Filled.Close" />
                        }
                        @if (CurrentValue.Count > 3)
                        {
                            <MudChip T="string" 
                                   Color="Color.Secondary" 
                                   Text="@($"+{CurrentValue.Count - 3} more")" />
                        }
                    </MudStack>
                }
            </MudStack>
        </MudPaper>
    </CustomContent>
</MudFileUpload>

<MudToolBar Gutters="@false" Class="relative d-flex justify-end gap-4 mt-2">
    @* @ref so ClearAsync can return focus here — the Clear All button unmounts itself, so without
       this focus falls to <body> (#281). *@
    <MudButton @ref="@BrowseButton"
               Color="Color.Primary"
               OnClick="@OpenFilePickerAsync"
               Variant="@ButtonVariant"
               StartIcon="@Icons.Material.Filled.FolderOpen"
               Size="Size.Small"
               aria-describedby="@RequiredDescribedBy">
        Browse
    </MudButton>
    @if (CurrentValue?.Any() == true)
    {
        <MudButton Color="Color.Error"
                   OnClick="@ClearAsync"
                   Variant="@ButtonVariant"
                   StartIcon="@Icons.Material.Filled.Clear"
                   Size="Size.Small">
            Clear All
        </MudButton>
    }
</MudToolBar>

@if (NativeRequiredValue)
{
    @* Rendered outside the label's @if on purpose: a field with a blank label has no visible
       marker to carry, so this description is the only channel left to it. *@
    <FileUploadRequiredHint Id="@RequiredDescriptionId" Text="@RequiredDescription" />
}

@if (!string.IsNullOrEmpty(HelpText))
{
    <div style="margin-top: -2px; overflow: hidden">
        <div class="d-flex mud-input-helper-text">
            <div class="me-auto">@HelpText</div>
        </div>
    </div>
}