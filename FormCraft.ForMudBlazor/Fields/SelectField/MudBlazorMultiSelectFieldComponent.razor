@namespace FormCraft.ForMudBlazor
@typeparam TModel
@typeparam TItem
@inherits MudBlazorFieldComponentBase<TModel, IEnumerable<TItem>>

<MudSelect
    T="TItem"
    Label="@Label"
    MultiSelection="true"
    SelectedValues="@_selectedValues"
    SelectedValuesChanged="@OnSelectedValuesChanged"
    Placeholder="@Placeholder"
    HelperText="@HelpText"
    ReadOnly="@IsReadOnly"
    Disabled="@IsDisabled"
    Variant="@EffectiveVariant"
    Margin="Margin.Dense"
    ShrinkLabel="@EffectiveShrinkLabel"
    Required="@EffectiveNativeRequired">
    @foreach (SelectOption<TItem> option in Options)
    {
        <MudSelectItem T="TItem" Value="@option.Value">
            @option.Label
        </MudSelectItem>
    }
</MudSelect>
