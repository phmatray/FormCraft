@namespace FormCraft.ForMudBlazor
@typeparam TModel
@typeparam TValue
@inherits MudBlazorFieldComponentBase<TModel, TValue>

<MudTextField
    T="string"
    Label="@Label"
    Value="@_displayText"
    Placeholder="@Placeholder"
    HelperText="@HelpText"
    ReadOnly="true"
    Disabled="@IsDisabled"
    Variant="@EffectiveVariant"
    Margin="Margin.Dense"
    ShrinkLabel="@EffectiveShrinkLabel"
    Required="@EffectiveNativeRequired"
    aria-required="@AriaRequired"
    Adornment="Adornment.End"
    AdornmentIcon="@Icons.Material.Filled.Search"
    OnAdornmentClick="@OpenLookupDialog"
    AdornmentAriaLabel="Open lookup" />
